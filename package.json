{
  "name": "togo-todo-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "tgtd-Frontend",
    "tgtd-Backend",
    "tgtd-Agent",
    "tgtd-AI-RAG"
  ],
  "scripts": {
    "dev": "npm --workspace tgtd-Frontend run dev --",
    "build": "npm --workspace tgtd-Frontend run build --",
    "build:webpack": "npm --workspace tgtd-Frontend run build:webpack --",
    "start": "npm --workspace tgtd-Frontend run start --",
    "lint": "npm --workspace tgtd-Frontend run lint --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm --workspace tgtd-Frontend run test --",
    "test:watch": "npm --workspace tgtd-Frontend run test:watch --",
    "test:e2e": "npm --workspace tgtd-Frontend run test:e2e --",
    "seed:demo": "npm --workspace tgtd-Backend run seed:demo --",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build:webpack"
  }
}
